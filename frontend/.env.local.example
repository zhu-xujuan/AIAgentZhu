NEXT_PUBLIC_API_URL=http://localhost:8001

# Optional: Prefer Presenton for PPTX export (Slide Studio -> PPTX)
# PRESENTON_URL=http://localhost:5000
# PRESENTON_API_KEY=YOUR_KEY
# PRESENTON_TEMPLATE=modern
# PRESENTON_THEME=professional-blue
# PRESENTON_LANGUAGE=Japanese
#
# Optional/unsafe: Allow fetching images from private networks (SSRF risk)
# ALLOW_UNSAFE_IMAGE_FETCH=true

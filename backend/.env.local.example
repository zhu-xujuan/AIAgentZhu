# =============================================================================
# ローカル開発環境用の設定ファイル（Docker外）
# =============================================================================
# このファイルをコピーして .env.local として使用してください
# cp .env.local.example .env.local
# =============================================================================

# =============================================================================
# Database Configuration
# =============================================================================
# ローカル開発では、localhost を使用
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aiagent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=aiagent123

# =============================================================================
# AI Agent Configuration (Ollama / vLLM)
# =============================================================================
# Provider type: ollama
AI_PROVIDER=ollama

# Base URL for Ollama API
# Option 1: Cloudflare Tunnel経由（推奨）
AI_BASE_URL=https://ollama.kabu-ai.jp

# Option 2: 旧サーバー（必要に応じて切替）
# AI_BASE_URL=http://100.93.85.78:11434

# Option 3: ローカルOllama
# AI_BASE_URL=http://localhost:11434

# API Key (not required for Ollama)
AI_API_KEY=

# Model name
AI_MODEL=qwen3:30b

# Embedding model (for vector search)
AI_EMBEDDING_MODEL=nomic-embed-text

# Request settings
AI_TIMEOUT=180
AI_MAX_RETRIES=2
SLIDE_GENERATION_TIMEOUT=45
AI_ENABLED=true

# Parallel processing settings
AI_MAX_CONCURRENT_EMBEDDINGS=4
AI_MAX_CONCURRENT_DOCUMENTS=3

# =============================================================================
# Image Generation (optional)
# =============================================================================
IMAGE_GEN_ENABLED=false
IMAGE_GEN_PROVIDER=openai
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=https://api.openai.com/v1
IMAGE_GEN_MODEL=gpt-image-1
IMAGE_GEN_SIZE=1024x1024
IMAGE_GEN_QUALITY=medium
IMAGE_GEN_MAX_PER_DECK=6
IMAGE_GEN_TIMEOUT=60

# =============================================================================
# Agent-specific LLM Settings
# =============================================================================
LLM_FACT_EXTRACTOR_ENABLED=true
LLM_SQL_QUERY_ENABLED=true
LLM_ANSWER_FORMATTER_ENABLED=true
LLM_DOCUMENT_CLASSIFIER_ENABLED=true
LLM_QUALITY_GUARDIAN_ENABLED=true

# =============================================================================
# API Server Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000

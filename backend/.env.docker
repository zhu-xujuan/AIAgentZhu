# =============================================================================
# Docker環境用の設定ファイル
# =============================================================================
# このファイルはDocker Composeで起動する際に使用されます
# ローカル開発（Docker外）の場合は .env.local を使用してください
# =============================================================================

# =============================================================================
# Database Configuration
# =============================================================================
# Docker環境では、サービス名 'postgres' を使用
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aiagent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=aiagent123

# =============================================================================
# AI Agent Configuration (Ollama via Cloudflare Tunnel)
# =============================================================================
# Provider type: ollama
AI_PROVIDER=ollama

# Base URL for Ollama API via Cloudflare Tunnel
# External access via ollama.kabu-ai.jp domain (HTTPS)
AI_BASE_URL=https://ollama.kabu-ai.jp

# API Key (not required for Ollama)
AI_API_KEY=

# Model name (use gemma3:4b as specified in the Ollama guide)
AI_MODEL=gemma3:4b

# Embedding model (for vector search)
AI_EMBEDDING_MODEL=nomic-embed-text

# Request settings
AI_TIMEOUT=60
AI_MAX_RETRIES=2
AI_ENABLED=true

# Parallel processing settings
# Note: Adjust based on Ollama server capacity
AI_MAX_CONCURRENT_EMBEDDINGS=4
AI_MAX_CONCURRENT_DOCUMENTS=3

# =============================================================================
# Agent-specific LLM Settings
# =============================================================================
# All agents enabled by default (uses LLM-enhanced processing)
LLM_FACT_EXTRACTOR_ENABLED=true
LLM_SQL_QUERY_ENABLED=true
LLM_ANSWER_FORMATTER_ENABLED=true
LLM_DOCUMENT_CLASSIFIER_ENABLED=true
LLM_QUALITY_GUARDIAN_ENABLED=true

# Optional: Agent-specific models (leave empty to use default AI_MODEL)
# LLM_FACT_EXTRACTOR_MODEL=
# LLM_SQL_QUERY_MODEL=
# LLM_ANSWER_FORMATTER_MODEL=
# LLM_DOCUMENT_CLASSIFIER_MODEL=
# LLM_QUALITY_GUARDIAN_MODEL=

# =============================================================================
# API Server Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
